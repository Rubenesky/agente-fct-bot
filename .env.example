ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
GEMINI_API_KEY=your-gemini-api-key

# Opcional - solo lo usa controller.py (bot de Telegram en Render) para
# comitear y pushear offers.db a git tras cada aprobación/descarte, ya que
# Render no tiene disco persistente. Sin esta variable el bot funciona
# igual, pero las decisiones no se sincronizan con git.
# Cómo generarlo: GitHub -> Settings -> Developer settings -> Personal
# access tokens -> Fine-grained tokens -> New token, con acceso solo a este
# repositorio y permiso "Contents: Read and write" (o, si usas un token
# clásico, el scope "repo").
GIT_PUSH_TOKEN=your-github-personal-access-token
